APP_ENV=development
APP_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hexbay
DB_USER=root
DB_PASSWORD=

# Generate a private value of at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-local-secret-at-least-32-characters
JWT_ISSUER=hexbay-local-api
JWT_AUDIENCE=hexbay-react
JWT_TTL_SECONDS=3600

AI_SERVICE_URL=http://127.0.0.1:5000
# Must match INTERNAL_SERVICE_SECRET in ai-service/.env.
AI_SERVICE_SECRET=replace-with-the-ai-service-secret
AI_SERVICE_TIMEOUT_SECONDS=8
# Enabled only when APP_ENV=development; labels results as demonstration data.
PERIPHERAL_DEMO_MODE=true
